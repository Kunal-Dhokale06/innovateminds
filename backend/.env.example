# ModelRouter Environment Configuration
APP_NAME=ModelRouter
APP_ENV=development
PORT=8000
HOST=127.0.0.1
DATABASE_URL=sqlite:///./modelrouter.db

# Master encryption key (32 bytes hex)
MODELROUTER_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Real Upstream Provider API Keys
# Add your live API keys below to route requests to real upstream AI models.
# If left blank, the router will automatically and safely fall back to high-fidelity mock engines.
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Privacy & Audit Logging
LOG_PAYLOADS=true

# Routing Defaults
DEFAULT_MAX_BUDGET_USD=0.05
DEFAULT_MAX_LATENCY_SLA_MS=3000.0
DEFAULT_TIMEOUT_MS=5000
GLOBAL_REQUEST_TIMEOUT_MS=15000
